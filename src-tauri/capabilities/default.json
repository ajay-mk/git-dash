{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "allow-token-status",
    "allow-token-set",
    "allow-token-clear",
    "allow-github-graphql",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }]
    }
  ]
}
